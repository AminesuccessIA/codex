# Cloud runtime: Node.js must honor HTTPS_PROXY for Google API calls
NODE_USE_ENV_PROXY=1
NEXT_PUBLIC_SITE_URL=https://lapepiite.com
# Google Workspace Gmail API, server-side OAuth 2.0 only
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Sender must be the authorized Google mailbox or its permitted send-as alias
CONTACT_FROM_EMAIL=contact@lapepiite.com
CONTACT_TO_EMAIL=contact@lapepiite.com
# Optional future CRM webhook, not required for Google Workspace
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
