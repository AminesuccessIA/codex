# Cloud runtime: Node.js must honor HTTPS_PROXY for Google API calls
NODE_USE_ENV_PROXY=1
NEXT_PUBLIC_SITE_URL=https://www.lapepiite.com
# Google Workspace Gmail API, server-side OAuth 2.0 only
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Sender must be the authorized Google mailbox or its permitted send-as alias
CONTACT_FROM_EMAIL=contact@lapepiite.com
CONTACT_TO_EMAIL=contact@lapepiite.com
# Optional future CRM webhook, not required for Google Workspace
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Closed by default: enable only after real email receipt and privacy approval
CONTACT_FORM_ENABLED=false
CONTACT_EMAIL_VERIFIED=false
CONTACT_PRIVACY_APPROVED=false
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_FORM=
LEGAL_REGISTRATION_NUMBER=
LEGAL_REGISTER=
LEGAL_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_CONTACT=
PRIVACY_RETENTION=
PRIVACY_EMAIL_PROCESSOR=
PRIVACY_HOST_PROCESSOR=
PRIVACY_TRANSFER_DETAILS=

# Confirm only after checking the production anti-abuse protection.
CONTACT_ABUSE_PROTECTION_VERIFIED=false

# Optional public Microsoft listing; add only the company's verified profile URL.
NEXT_PUBLIC_MICROSOFT_PARTNER_PROFILE_URL=
